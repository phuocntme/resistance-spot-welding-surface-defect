# Model paths (relative to my_backend/ directory, or absolute)
YOLO_CHECKPOINT=../v5.1.pt
SAM_CHECKPOINT=../sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b

# Inference settings
YOLO_CONFIDENCE_THRESHOLD=0.25
POLYGON_SIMPLIFY_EPSILON=0.001
JOB_CLEANUP_KEEP_RECENT=5

# Server settings
ML_BACKEND_HOST=0.0.0.0
ML_BACKEND_PORT=9090
LOG_LEVEL=INFO
DEBUG_REQUESTS=false

# Label Studio label mapping
IMAGE_KEY=image
OUTPUT_FROM_NAME=label
OUTPUT_TO_NAME=image

# Label Studio connection (used by SDK internally)
# LABEL_STUDIO_URL=http://localhost:8080
# LABEL_STUDIO_API_KEY=
